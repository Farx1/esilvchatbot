# Copy to .env and fill in. Only variables actually read by the code are listed.

# Database (Prisma, SQLite)
DATABASE_URL=file:./db/custom.db

# LLM provider: ollama | gemini | openai | anthropic | huggingface (default: ollama)
AI_PROVIDER=ollama

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:latest

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-exp

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-sonnet-20240229

# Hugging Face
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=microsoft/DialoGPT-medium

# Admin area (/admin/login). SESSION_SECRET signs the admin session cookie: use a long random string,
# e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_PASSWORD=
SESSION_SECRET=

# NextAuth (/api/auth/*)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
